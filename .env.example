# Discord bot token — https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Discord application (client) ID — same page, General Information
DISCORD_CLIENT_ID=

# Guild to register slash commands into during dev (instant); omit for global (~1h propagation)
DISCORD_GUILD_ID=

# Optional: seconds between poll cycles. Default 600 (10 minutes).
# POLL_INTERVAL_SEC=600

# Optional: pause between two watches inside one poll cycle, drawn uniformly from
# [min, max). Defaults 2000-5000 ms. This is anti-burst insurance against looking
# automated: 0/0 is allowed but discouraged (rate-limit and bot-signature risk).
# Bad or negative values log a [config] warning and fall back to the defaults; a max
# below min is raised to min.
# STAGGER_MS_MIN=2000
# STAGGER_MS_MAX=5000

# Optional: SQLite database file location. Default "seatsniper.db" in the working directory.
# DB_PATH=seatsniper.db

# Optional: Uptime Kuma Push monitor URL. The bot pings it after each poll cycle
# so Kuma can alert you if the bot dies. The Kuma heartbeat interval should sit a
# bit above POLL_INTERVAL_SEC.
# UPTIME_KUMA_PUSH_URL=https://kuma.example.com/api/push/TOKEN
