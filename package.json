{
  "name": "seatsniper",
  "version": "0.2.0",
  "description": "Discord bot that watches BookMyShow and District (movies & events) and DMs you the moment tickets open. Self-hosted, Bun + TypeScript + SQLite, no API keys.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ishannaik/seatsniper.git"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "commands": "bun src/register.ts",
    "test": "bun test",
    "test:live": "bun integration.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts integration.ts",
    "lint:fix": "biome check --write src scripts integration.ts",
    "format": "biome format --write src scripts integration.ts",
    "format:check": "biome format src scripts integration.ts",
    "quality": "bun scripts/quality.ts",
    "deadcode": "bun scripts/deadcode.ts",
    "agents:sync": "bun scripts/gen-agents-modules.ts",
    "check": "bun run typecheck && bun run lint && bun run quality && bun run deadcode && bun test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "node-tls-client": "^2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "koffi"
  ]
}
