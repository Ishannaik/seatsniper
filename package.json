{
  "name": "seatsniper",
  "version": "0.2.0",
  "description": "Discord bot that watches BookMyShow and DMs you the moment tickets open. Self-hosted, Bun + TypeScript + SQLite, no API keys.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ishannaik/seatsniper.git"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "commands": "bun src/register.ts",
    "test": "bun test"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "node-tls-client": "^2.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "koffi"
  ]
}
