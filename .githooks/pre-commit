#!/usr/bin/env bash
# SeatSniper local pre-commit gate (mirrors CI quality-and-test + secrets jobs).
set -euo pipefail

# 1. Block accidental commits of live .env or SQLite DB files.
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if printf '%s\n' "$staged" | { grep -vE '(^|/)\.env\.example$' || true; } | grep -Eq '(^|/)\.env($|\.)|\.(db|sqlite|sqlite3)(-journal|-shm|-wal|\.bak)?$'; then
  echo "[pre-commit] ERROR: Refusing to commit .env or SQLite database files." >&2
  exit 1
fi

# 2. Block oversized staged files (>1 MB).
while IFS= read -r file; do
  [ -z "$file" ] && continue
  if [ -f "$file" ]; then
    size="$(wc -c <"$file")"
    if [ "$size" -gt 1048576 ]; then
      echo "[pre-commit] ERROR: Staged file '$file' exceeds 1 MB ($size bytes)." >&2
      exit 1
    fi
  fi
done <<<"$staged"

# 3. Secret scan staged diff when gitleaks is installed locally.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact -c .gitleaks.toml
fi

# 4. Run static typecheck, Biome lint, architecture/AGENTS.md drift gate, and dead-code gate.
bun run typecheck
bun run lint
bun run quality
bun run deadcode
